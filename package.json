{
  "name": "firestore-export-import",
  "version": "2.0.0",
  "description": "Herramientas unificadas para exportar, importar, buscar y gestionar datos de Firestore",
  "main": "firebase-utils.js",
  "bin": {
    "firebase-utils": "./firebase-utils.js"
  },
  "scripts": {
    "export": "node firebase-utils.js -e",
    "import": "node firebase-utils.js -i",
    "search": "node firebase-utils.js -s",
    "test": "node firebase-utils.js -t",
    "migrate": "node firebase-utils.js --migrate",
    "install-deps": "npm install"
  },
  "keywords": [
    "firebase",
    "firestore",
    "export",
    "import",
    "backup",
    "search",
    "utils"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^9.0.0"
  }
}
